# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=5000

# MongoDB
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

DB_NAME=chatapp

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (set to your frontend URL in production)
CLIENT_ORIGIN=http://localhost:3000
